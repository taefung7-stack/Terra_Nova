{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terranova.app/schemas/passage-mid-2.2.json",
  "title": "Terra Nova Passage MID v2.2 (TERRA / NEPTUNE / URANUS)",
  "type": "object",
  "required": ["schema_version", "id", "meta", "page1", "page2", "page3", "page4", "answers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.2-mid" },
    "id": { "type": "string", "pattern": "^\\d{4}-\\d{2}-[NTU]-\\d{2}$" },
    "meta": {
      "type": "object",
      "required": ["month", "sequence", "subject", "linked_unit", "part_ko", "achievement_standard", "difficulty", "cognitive_skill", "lexile", "ar_level", "key_concepts"],
      "additionalProperties": false,
      "properties": {
        "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}-[NTU]$" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 20 },
        "grade": { "enum": ["중1", "중2", "중3"] },
        "subject": { "enum": ["과학", "사회", "수학", "국어", "도덕", "역사", "영어"] },
        "linked_unit": { "type": "string", "minLength": 3, "maxLength": 120 },
        "part_ko": { "type": "string", "minLength": 2, "maxLength": 24 },
        "achievement_standard": { "type": "string", "minLength": 4, "maxLength": 32 },
        "achievement_verified": { "type": "boolean" },
        "difficulty": { "enum": ["쉬움", "중간", "어려움", "도전"] },
        "cognitive_skill": { "type": "string", "minLength": 2, "maxLength": 30 },
        "lexile": { "type": "string", "pattern": "^\\d{3,4}L$" },
        "ar_level": { "type": "number", "minimum": 3.0, "maximum": 9.0 },
        "key_concepts": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 30 } }
      }
    },
    "page1": {
      "type": "object",
      "required": ["title", "subtitle", "body", "illustration", "illustration_caption"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 80 },
        "subtitle": { "type": "string", "minLength": 3, "maxLength": 110 },
        "body": { "type": "string", "minLength": 1100, "maxLength": 2000 },
        "illustration": { "type": "string", "pattern": "^\\.\\./\\.\\./assets/illustrations/\\d{4}-\\d{2}-[NTU]/\\d{2}\\.(svg|png|jpg|webp)$" },
        "illustration_caption": { "type": "string", "minLength": 3, "maxLength": 100 }
      }
    },
    "page2": {
      "type": "object",
      "required": ["questions", "textbook_tieback"],
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "style", "stem", "choices", "answer_index"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "mock_objective" },
                  "style": { "type": "string", "minLength": 2, "maxLength": 30 },
                  "stem": { "type": "string", "minLength": 5, "maxLength": 400 },
                  "choices": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 220 } },
                  "answer_index": { "type": "integer", "minimum": 0, "maximum": 4 }
                }
              },
              {
                "type": "object",
                "required": ["type", "style", "stem", "statements", "model_answer"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "tf_evidence" },
                  "style": { "type": "string", "minLength": 2, "maxLength": 30 },
                  "stem": { "type": "string", "minLength": 5, "maxLength": 200 },
                  "statements": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "required": ["text", "answer", "evidence_line"],
                      "additionalProperties": false,
                      "properties": {
                        "text": { "type": "string", "minLength": 5, "maxLength": 200 },
                        "answer": { "enum": ["T", "F"] },
                        "evidence_line": { "type": "integer", "minimum": 1, "maximum": 30 }
                      }
                    }
                  },
                  "model_answer": { "type": "string", "minLength": 3, "maxLength": 200 }
                }
              },
              {
                "type": "object",
                "required": ["type", "style", "stem", "words", "pool", "model_answer"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "match" },
                  "style": { "type": "string", "minLength": 2, "maxLength": 30 },
                  "stem": { "type": "string", "minLength": 5, "maxLength": 200 },
                  "words": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "required": ["text", "kind", "target"],
                      "additionalProperties": false,
                      "properties": {
                        "text": { "type": "string", "minLength": 1, "maxLength": 40 },
                        "kind": { "enum": ["SYN", "ANT"] },
                        "target": { "type": "integer", "minimum": 0, "maximum": 5 }
                      }
                    }
                  },
                  "pool": {
                    "type": "array",
                    "minItems": 6,
                    "maxItems": 6,
                    "items": { "type": "string", "minLength": 1, "maxLength": 40 }
                  },
                  "model_answer": { "type": "string", "minLength": 3, "maxLength": 200 }
                }
              },
              {
                "type": "object",
                "required": ["type", "style", "stem", "items", "model_answer"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "short_translate" },
                  "style": { "type": "string", "minLength": 2, "maxLength": 30 },
                  "stem": { "type": "string", "minLength": 5, "maxLength": 200 },
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "required": ["direction", "text"],
                      "additionalProperties": false,
                      "properties": {
                        "direction": { "enum": ["en2ko", "ko2en"] },
                        "text": { "type": "string", "minLength": 5, "maxLength": 200 }
                      }
                    }
                  },
                  "model_answer": { "type": "string", "minLength": 3, "maxLength": 400 }
                }
              },
              {
                "type": "object",
                "required": ["type", "style", "stem", "max_words", "model_answer"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "short_answer" },
                  "style": { "type": "string", "minLength": 2, "maxLength": 30 },
                  "stem": { "type": "string", "minLength": 5, "maxLength": 300 },
                  "max_words": { "type": "integer", "minimum": 1, "maximum": 10 },
                  "model_answer": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            ]
          }
        },
        "textbook_tieback": {
          "type": "object",
          "required": ["unit_label", "body_ko", "tags"],
          "additionalProperties": false,
          "properties": {
            "unit_label": { "type": "string", "minLength": 3, "maxLength": 80 },
            "body_ko": { "type": "string", "minLength": 120, "maxLength": 500 },
            "tags": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 24 } },
            "visual_aid": {
              "type": "object",
              "required": ["type", "title", "steps"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["emoji_flow", "compare", "mindmap", "timeline"] },
                "title": { "type": "string", "minLength": 1, "maxLength": 40 },
                "steps": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "required": ["emoji", "label"],
                    "additionalProperties": false,
                    "properties": {
                      "emoji": { "type": "string", "minLength": 1, "maxLength": 8 },
                      "label": { "type": "string", "minLength": 0, "maxLength": 30 },
                      "note": { "type": "string", "minLength": 0, "maxLength": 60 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "page3": {
      "type": "object",
      "required": ["sentences", "translation_ko"],
      "additionalProperties": false,
      "properties": {
        "sentences": {
          "type": "array",
          "minItems": 4,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["index", "segments"],
            "additionalProperties": false,
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "segments": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": ["role", "text"],
                  "additionalProperties": false,
                  "properties": {
                    "role": { "enum": ["S", "V", "O", "C", "M", "CONJ", "REL", ""] },
                    "text": { "type": "string", "minLength": 1, "maxLength": 180 },
                    "note": { "type": "string", "minLength": 1, "maxLength": 50 }
                  }
                }
              },
              "grammar_note": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        },
        "translation_ko": { "type": "string", "minLength": 100, "maxLength": 2400 }
      }
    },
    "page4": {
      "type": "object",
      "required": ["vocab"],
      "additionalProperties": false,
      "properties": {
        "vocab": {
          "type": "array",
          "minItems": 10,
          "maxItems": 12,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["card_type", "phrase", "pattern", "meaning_ko", "examples"],
                "additionalProperties": false,
                "properties": {
                  "card_type": { "const": "collocation" },
                  "phrase": { "type": "string", "minLength": 2, "maxLength": 40 },
                  "pattern": { "type": "string", "minLength": 2, "maxLength": 32 },
                  "meaning_ko": { "type": "string", "minLength": 1, "maxLength": 60 },
                  "examples": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "required": ["en", "ko"],
                      "additionalProperties": false,
                      "properties": {
                        "en": { "type": "string", "minLength": 5, "maxLength": 180 },
                        "ko": { "type": "string", "minLength": 3, "maxLength": 120 }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["card_type", "word", "root", "root_meaning", "meaning_ko", "kin"],
                "additionalProperties": false,
                "properties": {
                  "card_type": { "const": "word_root" },
                  "word": { "type": "string", "minLength": 2, "maxLength": 32 },
                  "root": { "type": "string", "minLength": 2, "maxLength": 32 },
                  "root_meaning": { "type": "string", "minLength": 2, "maxLength": 40 },
                  "meaning_ko": { "type": "string", "minLength": 1, "maxLength": 60 },
                  "kin": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "required": ["en", "ko"],
                      "additionalProperties": false,
                      "properties": {
                        "en": { "type": "string", "minLength": 2, "maxLength": 32 },
                        "ko": { "type": "string", "minLength": 1, "maxLength": 40 }
                      }
                    }
                  },
                  "example": {
                    "type": "object",
                    "required": ["en", "ko"],
                    "additionalProperties": false,
                    "properties": {
                      "en": { "type": "string", "minLength": 5, "maxLength": 180 },
                      "ko": { "type": "string", "minLength": 3, "maxLength": 120 }
                    }
                  }
                }
              },
              {
                "type": "object",
                "required": ["card_type", "word", "pos", "meaning_ko", "examples"],
                "additionalProperties": false,
                "properties": {
                  "card_type": { "const": "word" },
                  "word": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "pos": { "type": "string", "minLength": 1, "maxLength": 10 },
                  "meaning_ko": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "synonyms": { "type": "array", "minItems": 0, "maxItems": 4, "items": { "type": "string", "maxLength": 30 } },
                  "antonyms": { "type": "array", "minItems": 0, "maxItems": 4, "items": { "type": "string", "maxLength": 30 } },
                  "examples": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "required": ["en", "ko"],
                      "additionalProperties": false,
                      "properties": {
                        "en": { "type": "string", "minLength": 5, "maxLength": 180 },
                        "ko": { "type": "string", "minLength": 3, "maxLength": 120 }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "answers": {
      "type": "object",
      "required": ["explanations"],
      "additionalProperties": false,
      "properties": {
        "explanations": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["q_index", "q_type", "evidence", "rationales"],
            "additionalProperties": false,
            "properties": {
              "q_index": { "type": "integer", "minimum": 0, "maximum": 3 },
              "q_type": { "enum": ["mock_objective", "tf_evidence", "match", "short_translate", "short_answer"] },
              "correct": {
                "oneOf": [
                  { "type": "integer", "minimum": 0, "maximum": 4 },
                  { "type": "null" }
                ]
              },
              "evidence": { "type": "string", "minLength": 10, "maxLength": 600 },
              "rationales": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": { "type": "string", "minLength": 5, "maxLength": 280 }
              },
              "model_answer": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        }
      }
    }
  }
}
